{
  "expo": {
    "name": "memory-stamp-app",
    "slug": "memory-stamp-app",
    "version": "1.0.0",
    "scheme": "memorystamp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Memory Stamp uses your camera so you can capture a new photo for a stamp.",
        "NSPhotoLibraryUsageDescription": "Memory Stamp uses your photo library so you can choose a picture to add to a stamp."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.aninhabort.memorystampapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Memory Stamp uses your camera so you can capture a new photo for a stamp.",
          "photosPermission": "Memory Stamp uses your photo library so you can choose a picture to add to a stamp.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a0301f5e-964e-4236-8d7c-1e956c0a30de"
      }
    }
  }
}
